<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HORIZON1</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        /* Пастельні стилі для шапки */
        .navbar {
            background-color: #f8f9fa; /* Світлий фон */
            border-bottom: 2px solid #e3f2fd;
            padding: 15px 0;
        }

        .navbar-brand {
            font-weight: bold;
            color: #90caf9 !important; /* Пастельно-блакитний логотип */
            font-size: 1.5rem;
        }

        /* Стиль кнопки Telegram */
        .btn-telegram {
            background-color: #bde0fe; /* Пастельний блакитний */
            color: #444;
            border-radius: 20px;
            font-weight: 600;
            padding: 8px 20px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            border: none;
        }

        .btn-telegram:hover {
            background-color: #a2d2ff;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            color: #000;
        }

        main {
            padding-top: 30px;
        }

        footer {
            border-top: 1px solid #eee;
            color: #999;
            margin-top: 50px;
            padding: 20px 0;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">HORIZON1</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Головна</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Events" asp-action="Index">Календар</a>
                        </li>
                    </ul>
                    
                    <div class="d-flex align-items-center">
                        <a href="https://t.me/Horizon1_bot" target="_blank" class="btn-telegram">
                            🌟 Нагадування в Telegram
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody() </main>
    </div>

    <footer class="footer text-muted text-center">
        <div class="container">
            &copy; 2026 - HORIZON1 - Плануй свій час розумно
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>